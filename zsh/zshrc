# J.K. Robotics banner, once per terminal window: shells started inside it
# (herdr panes, subshells) inherit JK_BANNER_SHOWN, which jk_os's dev session
# (jk-dev) also sets after showing it. Not on the Linux text console, which has
# /etc/issue. DOTFILES_NO_BANNER=1 turns it off. Printed above the instant
# prompt, which must not see console output.
if [[ -o interactive && -t 1 && -z $JK_BANNER_SHOWN && -z $DOTFILES_NO_BANNER && $TERM != linux ]]; then
  for _banner in /usr/share/jk_os/banner "${${(%):-%x}:A:h:h}/branding/banner"; do
    if [[ -r $_banner ]]; then
      print; print -r -- "$(<$_banner)"; print
      export JK_BANNER_SHOWN=1
      break
    fi
  done
  unset _banner
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# Not on the Linux text console: the cached prompt would carry Nerd Font icons.
if [[ $TERM != linux && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Machine-specific PATHs, toolchains and secrets (API keys etc.) live in
# ~/.zshrc.local, which is NOT in the dotfiles repo.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

# Add this line before calling compinit
ZSH_DISABLE_COMPFIX=true

# Call compinit
autoload -Uz compinit
compinit

plugins=(git fzf-tab zsh-autosuggestions zsh-syntax-highlighting web-search jsontools)
# jk_os has ssh and nc, but does not ship dig.
if (( $+commands[ssh] && $+commands[dig] && $+commands[nc] )); then
    plugins+=(sshinfo)
fi

source $ZSH/oh-my-zsh.sh

# In an ASCII locale (a console on an image without C.UTF-8), oh-my-zsh
# reports the directory to the terminal through iconv, which jk_os lacks.
# Only graphical terminals use that report.
zmodload zsh/langinfo
if [[ $langinfo[CODESET] != (utf|UTF)(-|)8 ]] && (( $+functions[omz_termsupport_cwd] )); then
    add-zsh-hook -d precmd omz_termsupport_cwd
fi

# fzf key bindings (ctrl-r, ctrl-t, alt-c); location differs per distro
if (( $+commands[fzf] )) && fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
else
for f in /usr/share/doc/fzf/examples/key-bindings.zsh \
         /usr/share/fzf/key-bindings.zsh \
         /usr/share/fzf/shell/key-bindings.zsh \
         /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
         /usr/local/opt/fzf/shell/key-bindings.zsh; do
    [[ -f $f ]] && source $f && break
done
unset f
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

