#!/bin/sh
# Copy stdin to the desktop clipboard. Prefer native Wayland in Plasma.
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
  exec wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard
elif command -v pbcopy >/dev/null 2>&1; then
  exec pbcopy
fi
echo 'No clipboard available: install wl-clipboard (Wayland) or xclip (X11).' >&2
exit 1
