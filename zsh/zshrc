alias sc="sudo rm -rf ./*"
fcc() {
    local file
    IFS= read -r -d '' file < <(fzf --read0 --print0 --preview 'bat --style=numbers --color=always {}' < <(find . -type f -print0)) || return
    dotfiles-copy < "$file"
}
fpc() {
    local file
    IFS= read -r -d '' file < <(fzf --read0 --print0 --preview 'bat --style=numbers --color=always {}' < <(find . -type f -print0)) || return
    printf '%s' "$file" | dotfiles-copy
}

