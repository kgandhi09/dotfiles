# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# The Linux text console (tty1/tty2 before the desktop) only has a small
# bitmap font: no Nerd Font icons or most Unicode symbols. Serial consoles are
# drawn by the terminal on the other end and keep the full prompt.
if [[ $TERM == linux ]] && (( $+functions[p10k] )); then
    typeset -g POWERLEVEL9K_MODE=ascii
    typeset -g POWERLEVEL9K_INSTANT_PROMPT=off
    typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIINS_CONTENT_EXPANSION='>'
    typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VICMD_CONTENT_EXPANSION='<'
    typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIOWR_CONTENT_EXPANSION='^'
    typeset -g POWERLEVEL9K_STATUS_{OK,OK_PIPE}_VISUAL_IDENTIFIER_EXPANSION='ok'
    typeset -g POWERLEVEL9K_STATUS_{ERROR,ERROR_SIGNAL,ERROR_PIPE}_VISUAL_IDENTIFIER_EXPANSION='x'
    typeset -g POWERLEVEL9K_RULER_CHAR='-'
    typeset -g POWERLEVEL9K_VCS_BRANCH_ICON=
    p10k reload
fi

# Always use steady underline cursor inside Herdr
if [[ "$HERDR_ENV" == "1" ]]; then
    PROMPT_COMMAND='printf "\e[4 q";'"$PROMPT_COMMAND"
fi

# VS Code style Herdr layout:
# Neovim on top + terminal below
code() {
    local dir="${1:-.}"

    cd "$dir" || return 1

    # Create terminal pane below, occupying 25%
    herdr pane split \
        --current \
        --direction down \
        --ratio 0.75 \
        --cwd "$PWD" \
        --no-focus >/dev/null || return 1

    # Open Neovim in the original/top pane
    vi 
}
